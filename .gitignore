# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Virtual environments
.venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store

# FauxCall runtime state (fakes write these at runtime; recorded data under data/ IS committed)
.fauxcall/
**/data/state/
**/data/*.lock
