# Generated by FauxCall: one uv workspace holding every fake of this project.
# `fauxcall scaffold` keeps `members` up to date; each fake declares its own dev tools.

[tool.uv.workspace]
members = [{% for member in members %}"{{ member }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% if fauxcall_path %}

[tool.uv.sources]
fauxcall = { path = {{ fauxcall_path | toml }}, editable = true }
{% endif %}
