# Generated by FauxCall (`fauxcall scaffold`). Build context is this workspace so the lock file is shared.
services:
{% for fake in fakes %}
  {{ fake.name }}:
    build:
      context: .
      dockerfile: {{ fake.name }}/Dockerfile
    ports:
      - "{{ fake.port }}:{{ fake.port }}"
    env_file:
      - path: {{ fake.name }}/.env
        required: false
    environment:
      FAUXCALL_HOST: "0.0.0.0"
      FAUXCALL_PORT: "{{ fake.port }}"
      # The real API's credentials and the pseudonym key are for recording and parity runs only:
      # the running fake never uses them, so they stay out of the container.
      FAUXCALL_REAL__HEADERS: "{}"
      FAUXCALL_REAL__QUERY: "{}"
      FAUXCALL_PSEUDONYM_KEY: ""
{% endfor %}
