   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "name": "trigger-url-elicitation",
     "arguments": {
      "url": "  https://example.com/padded  ",
      "elicitationId": "trim-1"
     }
    }
   },
   "client_replies": {
    "elicitation/create": {
     "action": "accept"
    }
   }
  },
  {
   "id": "url-newline",
   "endpoint": "MCP tools/call:trigger-url-elicitation",
   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "name": "trigger-url-elicitation",
     "arguments": {
      "url": "https://exa\nmple.com/nl",
      "elicitationId": "trim-2"
     }
    }
   },
   "client_replies": {
    "elicitation/create": {
     "action": "accept"
    }
   }
  },
  {
