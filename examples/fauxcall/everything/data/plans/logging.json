{
  "name": "logging",
  "created_at": "2026-10-15T00:50:00Z",
  "note": "toggle-simulated-logging: on (log messages every 5 s on the GET stream, random levels), the client's logging/setLevel filter, off, and on/off answers. Pings with intervals keep the session open while the GET stream is recorded.",
  "listen": true,
  "listen_after_seconds": 2,
  "calls": [
    {"id": "log-on", "endpoint": "MCP tools/call:toggle-simulated-logging", "purpose": "sample",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-simulated-logging", "arguments": {}}}},
    {"id": "log-wait-all", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 4, "interval_ms": 5000},
    {"id": "log-level-error", "endpoint": "MCP logging/setLevel", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"level": "error"}}},
    {"id": "log-wait-error", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 5, "interval_ms": 5000},
    {"id": "log-off", "endpoint": "MCP tools/call:toggle-simulated-logging", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-simulated-logging", "arguments": {}}}},
    {"id": "log-wait-off", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 5000},
    {"id": "log-on-again", "endpoint": "MCP tools/call:toggle-simulated-logging", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-simulated-logging", "arguments": {"ignored": true}}}},
    {"id": "log-level-debug", "endpoint": "MCP logging/setLevel", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"level": "debug"}}},
    {"id": "log-wait-debug", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 3, "interval_ms": 5000},
    {"id": "log-off-again", "endpoint": "MCP tools/call:toggle-simulated-logging", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-simulated-logging", "arguments": {}}}}
  ]
}
