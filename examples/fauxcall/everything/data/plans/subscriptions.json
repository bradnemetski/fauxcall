{
  "name": "subscriptions",
  "created_at": "2026-10-15T00:50:00Z",
  "note": "resources/subscribe + toggle-subscriber-updates: the subscribe/unsubscribe log messages and the notifications/resources/updated pushes every 5 s for each subscribed URI, on the GET stream; unsubscribing one URI; turning updates off.",
  "listen": true,
  "listen_after_seconds": 2,
  "calls": [
    {"id": "sub-toggle-empty", "endpoint": "MCP tools/call:toggle-subscriber-updates", "purpose": "sample",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-subscriber-updates", "arguments": {}}}},
    {"id": "sub-wait-empty", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 5000},
    {"id": "sub-features", "endpoint": "MCP resources/subscribe:demo://resource/static/document/features.md", "purpose": "sample",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"uri": "demo://resource/static/document/features.md"}}},
    {"id": "sub-text-1", "endpoint": "MCP resources/subscribe:demo://resource/dynamic/text/1", "purpose": "sample",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"uri": "demo://resource/dynamic/text/1"}}},
    {"id": "sub-wait-two", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 3, "interval_ms": 5000},
    {"id": "unsub-text-1", "endpoint": "MCP resources/unsubscribe:demo://resource/dynamic/text/1", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"uri": "demo://resource/dynamic/text/1"}}},
    {"id": "sub-wait-one", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 5000},
    {"id": "sub-toggle-off", "endpoint": "MCP tools/call:toggle-subscriber-updates", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-subscriber-updates", "arguments": {}}}},
    {"id": "sub-wait-off", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 5000},
    {"id": "sub-toggle-on-subscribed", "endpoint": "MCP tools/call:toggle-subscriber-updates", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "toggle-subscriber-updates", "arguments": {}}}},
    {"id": "sub-wait-again", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 1, "interval_ms": 0},
    {"id": "unsub-features", "endpoint": "MCP resources/unsubscribe:demo://resource/static/document/features.md", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"uri": "demo://resource/static/document/features.md"}}},
    {"id": "sub-wait-none", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 5000}
  ]
