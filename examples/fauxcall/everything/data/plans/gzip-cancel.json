{
 "name": "gzip-cancel",
 "created_at": "2026-10-26T20:00:00Z",
 "listen": true,
 "listen_after_seconds": 2,
 "note": "on_cancel evidence: cancel a writing tool mid-fetch, then list resources to see whether the write happened.",
 "calls": [
  {
   "id": "cancel-list-before",
   "endpoint": "MCP resources/list",
   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {}
   }
  },
  {
   "id": "gzip-cancelled-default",
   "endpoint": "MCP tools/call:gzip-file-as-resource",
   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "name": "gzip-file-as-resource",
     "arguments": {
      "name": "cancelled.md.gz"
     }
    }
   },
   "cancel_after_ms": 40
  },
  {
   "id": "cancel-wait",
   "endpoint": "MCP ping",
   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {}
   },
   "repeat": 2,
   "interval_ms": 1500
  },
  {
   "id": "cancel-list-after",
   "endpoint": "MCP resources/list",
   "purpose": "edge",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {}
   }
  },
  {
   "id": "gzip-default-resource",
   "endpoint": "MCP tools/call:gzip-file-as-resource",
   "purpose": "sample",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "name": "gzip-file-as-resource",
     "arguments": {
      "outputType": "resource"
     }
    }
   }
  }
 ]
}