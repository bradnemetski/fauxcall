{
 "name": "review2-probes",
 "created_at": "2026-10-15T05:00:00Z",
 "note": "Second-review probes, all non-mutating (no approval budget): an invalid initialize inside an existing session (the SDK only treats a schema-valid initialize as a handshake), zod's 'received' member for an infinite task ttl, and the related-task lookup for methods FauxCall's runtime answers itself and for an unknown tool. Plus two more invalid handshakes in the session (many bad fields; empty params) to model the refusal.",
 "calls": [
  {
   "id": "r2-init-in-session-no-client-info",
   "endpoint": "MCP initialize",
   "purpose": "edge",
   "note": "inside the session: not a handshake for isInitializeRequest, so a plain request: expect HTTP 200 SSE with -32603 zod issues at params.clientInfo (fake: 400 'Server already initialized')",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "protocolVersion": "2025-06-18",
     "capabilities": {}
    }
   }
  },
  {
   "id": "r2-init-in-session-caps-array",
   "endpoint": "MCP initialize",
   "purpose": "edge",
   "note": "same, capabilities not an object: expect 200 with -32603 issue at params.capabilities",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "protocolVersion": "2025-06-18",
     "capabilities": [],
     "clientInfo": {
      "name": "fauxcall-probe",
      "version": "1.0.0"
     }
    }
   }
  },
  {
