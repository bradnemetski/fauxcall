{
  "name": "review-research-timeout",
  "created_at": "2026-10-18T08:00:00Z",
  "client_capabilities": {
    "elicitation": {}
  },
  "listen": true,
  "listen_after_seconds": 3,
  "note": "review: a queued clarification nobody fetches for over a minute",
  "calls": [
    {
      "id": "rq-timeout",
      "endpoint": "MCP tools/call:simulate-research-query",
      "purpose": "edge",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "name": "simulate-research-query",
          "arguments": {
            "topic": "Mercury",
            "ambiguous": true
          },
          "task": {}
        }
      },
      "capture": {
        "t": "$.result.task.taskId"
      }
    },
    {
      "id": "rq-timeout-get",
      "endpoint": "MCP tasks/get",
      "purpose": "job_poll",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "taskId": "{{t}}"
        }
      },
      "repeat": 7,
      "interval_ms": 11000
    },
    {
      "id": "rq-timeout-result",
      "endpoint": "MCP tasks/result",
      "purpose": "job_poll",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "taskId": "{{t}}"
        }
      },
      "client_replies": {
        "elicitation/create": {
          "action": "accept",
          "content": {
            "interpretation": "historical"
          }
        }
      }
    }
  ]
}