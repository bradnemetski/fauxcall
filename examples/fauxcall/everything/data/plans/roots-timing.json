{
 "name": "roots-timing",
 "created_at": "2026-10-13T22:00:00Z",
 "calls": [
  {
   "id": "rt-ping",
   "endpoint": "MCP ping",
   "purpose": "time_profile",
   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {}
   },
   "repeat": 3,
   "interval_ms": 1000
  },
  {
   "id": "rt-roots",
   "endpoint": "MCP tools/call:get-roots-list",
