   "request": {
    "method": "POST",
    "path": "/mcp",
    "json_body": {
     "name": "get-roots-list",
     "arguments": {}
    }
   },
   "client_replies": {
    "roots/list": {
     "roots": [
      {
       "uri": "file:///late",
       "name": "late"
      }
     ]
    }
   }
  }
 ],
 "client_capabilities": {
  "roots": {
   "listChanged": true
  }
 },
 "listen": true,
 "listen_after_seconds": 1
}