{
  "name": "research-listen",
  "created_at": "2026-10-15T01:20:00Z",
  "note": "simulate-research-query with the GET stream open: the notifications/tasks/status the server pushes at each status change (plain and ambiguous-with-elicitation tasks), and cancel (no push expected: the SDK cancels through the raw store).",
  "client_capabilities": {"elicitation": {}},
  "listen": true,
  "listen_after_seconds": 2,
  "calls": [
    {"id": "rl-create", "endpoint": "MCP tools/call:simulate-research-query", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "simulate-research-query", "arguments": {"topic": "coral reefs"}, "task": {"ttl": 1000}}},
     "capture": {"lt1": "$.result.task.taskId"}},
    {"id": "rl-result", "endpoint": "MCP tasks/result", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"taskId": "{{lt1}}"}}},
    {"id": "rl-create-amb", "endpoint": "MCP tools/call:simulate-research-query", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "simulate-research-query", "arguments": {"topic": "Python", "ambiguous": true}, "task": {"ttl": 60000}}},
     "capture": {"lt2": "$.result.task.taskId"}},
    {"id": "rl-get-amb", "endpoint": "MCP tasks/get", "purpose": "job_poll",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"taskId": "{{lt2}}"}}, "repeat": 3, "interval_ms": 1000},
    {"id": "rl-result-amb", "endpoint": "MCP tasks/result", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"taskId": "{{lt2}}"}},
     "client_replies": {"elicitation/create": {"action": "cancel"}}},
    {"id": "rl-create-cancel", "endpoint": "MCP tools/call:simulate-research-query", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"name": "simulate-research-query", "arguments": {"topic": "volcanoes"}, "task": {"ttl": 60000}}},
     "capture": {"lt3": "$.result.task.taskId"}},
    {"id": "rl-cancel", "endpoint": "MCP tasks/cancel", "purpose": "variation",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"taskId": "{{lt3}}"}}},
    {"id": "rl-list-cursor", "endpoint": "MCP tasks/list", "purpose": "edge",
     "request": {"method": "POST", "path": "/mcp", "json_body": {"cursor": "not-a-task"}}},
    {"id": "rl-get-missing-id", "endpoint": "MCP tasks/get", "purpose": "invalid",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}},
    {"id": "rl-wait", "endpoint": "MCP ping", "purpose": "time_profile",
     "request": {"method": "POST", "path": "/mcp", "json_body": {}}, "repeat": 2, "interval_ms": 2000}
  ]
}
