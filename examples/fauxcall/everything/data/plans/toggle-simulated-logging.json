      "request": {
        "method": "POST",
        "path": "/mcp"
      },
      "repeat": 2,
      "interval_ms": 12000
    },
    {
      "id": "log-off",
      "endpoint": "MCP tools/call:toggle-simulated-logging",
      "purpose": "variation",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "name": "toggle-simulated-logging",
          "arguments": {}
        }
      }
