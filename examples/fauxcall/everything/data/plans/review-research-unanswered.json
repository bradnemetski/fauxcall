{
  "name": "review-research-unanswered",
  "created_at": "2026-10-25T23:30:00Z",
  "client_capabilities": {
    "elicitation": {}
  },
  "listen": true,
  "listen_after_seconds": 2,
  "calls": [
    {
      "id": "rq-unanswered",
      "endpoint": "MCP tools/call:simulate-research-query",
      "purpose": "edge",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "name": "simulate-research-query",
          "arguments": {
            "topic": "python",
            "ambiguous": true
          },
          "task": {}
        }
      },
      "capture": {
        "task_id": "$.result.task.taskId"
      }
    },
    {
      "id": "rq-unanswered-poll",
      "endpoint": "MCP tasks/get",
      "purpose": "job_poll",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "taskId": "{{task_id}}"
        }
      },
      "repeat": 14,
      "interval_ms": 5000
    },
    {
      "id": "rq-unanswered-result",
      "endpoint": "MCP tasks/result",
      "purpose": "job_poll",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "json_body": {
          "taskId": "{{task_id}}"
        }
      },
      "client_replies": {
        "elicitation/create": {
          "action": "accept",
          "content": {
            "interpretation": "snake"
          }
        }
      }
    }
  ]
