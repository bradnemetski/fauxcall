# Copy to .env (gitignored) and fill in. Never commit real credentials.

# The real API (used when recording and by `pytest --target=real|parity`).
FAUXCALL_REAL__BASE_URL=https://fakerestapi.azurewebsites.net

# Pseudonymization key for personal data (generated once by `fauxcall init`; keep it secret and stable).
FAUXCALL_PSEUDONYM_KEY=

# Optional: Jev (TypeSafe) key for runtime judgments on inputs no recording covers.
TYPESAFE_API_KEY=
